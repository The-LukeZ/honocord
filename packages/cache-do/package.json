{
  "name": "@honocord/cache-do",
  "version": "0.3.1",
  "private": false,
  "type": "module",
  "description": "A Durable Objects cache adapter for Honocord.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "url": "git+https://github.com/The-LukeZ/honocord.git"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260808.1"
  },
  "dependencies": {
    "@honocord/cache-base": "workspace:*"
  }
}
