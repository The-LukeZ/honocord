{
  "name": "honocord",
  "version": "4.1.0",
  "private": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./cache": {
      "import": {
        "types": "./dist/cache/index.d.mts",
        "default": "./dist/cache/index.mjs"
      },
      "require": {
        "types": "./dist/cache/index.d.cts",
        "default": "./dist/cache/index.cjs"
      }
    },
    "./cache/memory": {
      "import": {
        "types": "./dist/cache/memory/index.d.mts",
        "default": "./dist/cache/memory/index.mjs"
      },
      "require": {
        "types": "./dist/cache/memory/index.d.cts",
        "default": "./dist/cache/memory/index.cjs"
      }
    },
    "./cache/do": {
      "import": {
        "types": "./dist/cache/do/index.d.mts",
        "default": "./dist/cache/do/index.mjs"
      },
      "require": {
        "types": "./dist/cache/do/index.d.cts",
        "default": "./dist/cache/do/index.cjs"
      }
    },
    "./cache/mongo": {
      "import": {
        "types": "./dist/cache/mongo/index.d.mts",
        "default": "./dist/cache/mongo/index.mjs"
      },
      "require": {
        "types": "./dist/cache/mongo/index.d.cts",
        "default": "./dist/cache/mongo/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "check": "prettier --check .",
    "test": "vitest",
    "docs:reference": "typedoc && node scripts/sync-typedoc-docs.mjs"
  },
  "keywords": [
    "hono",
    "discord",
    "cloudflare-workers",
    "honocord",
    "interactions"
  ],
  "author": "The-LukeZ",
  "license": "MIT",
  "packageManager": "pnpm@12.19.0",
  "type": "module",
  "dependencies": {
    "@discordjs/builders": "^1.15.0",
    "@discordjs/collection": "^2.1.1",
    "@discordjs/core": "^2.7.0",
    "@discordjs/rest": "^2.6.3",
    "discord-api-types": "0.38.58"
  },
  "peerDependencies": {
    "hono": "^4.13.1",
    "mongoose": "^9.9.1"
  },
  "peerDependenciesMeta": {
    "mongoose": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@cloudflare/workers-types": "^5.20261110.1",
    "@types/node": "^26.6.6",
    "hono": "^4.13.18",
    "mongoose": "^9.12.1",
    "prettier": "^3.10.0",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsdown": "0.23.7",
    "typedoc": "^0.28.20",
    "typedoc-plugin-frontmatter": "^1.3.3",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "6.0.3",
    "vitest": "^5.1.0"
  },
  "repository": {
    "url": "git+https://github.com/The-LukeZ/honocord.git"
  },
  "homepage": "https://honocord.thelukez.com",
  "bugs": {
    "url": "https://github.com/The-LukeZ/honocord/issues"
  },
  "engines": {
    "node": ">=24"
  }
}
