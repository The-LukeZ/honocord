{
  "name": "honocord",
  "version": "3.0.1",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "build:all": "pnpm build:packages && pnpm build",
    "dev": "tsdown --watch",
    "dev:packages": "pnpm --filter \"./packages/*\" dev",
    "typecheck": "tsc --noEmit",
    "typecheck:packages": "pnpm --filter \"./packages/*\" run typecheck",
    "format": "prettier --write .",
    "check": "prettier --check .",
    "test": "vitest",
    "docs:reference": "typedoc && node scripts/sync-typedoc-docs.mjs"
  },
  "keywords": [
    "hono",
    "discord",
    "cloudflare-workers",
    "honocord",
    "interactions"
  ],
  "author": "The-LukeZ",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "type": "module",
  "dependencies": {
    "@discordjs/builders": "^1.14.1",
    "@discordjs/collection": "^2.1.1",
    "@discordjs/core": "^2.6.0",
    "@discordjs/rest": "^2.6.3",
    "@honocord/cache-base": "workspace:*",
    "discord-api-types": "0.38.55"
  },
  "peerDependencies": {
    "hono": "^4.13.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@types/node": "^26.5.1",
    "hono": "^4.13.7",
    "prettier": "^3.9.6",
    "tsdown": "0.23.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-frontmatter": "^1.3.2",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.0"
  },
  "repository": {
    "url": "git+https://github.com/The-LukeZ/honocord.git"
  },
  "homepage": "https://honocord.thelukez.com",
  "bugs": {
    "url": "https://github.com/The-LukeZ/honocord/issues"
  },
  "engines": {
    "node": ">=22.9.0"
  }
}
