{
  "name": "honocord",
  "version": "2.0.1",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "build:packages": "pnpm --filter './packages/*' build",
    "build:all": "pnpm build:packages && pnpm build",
    "dev": "tsdown --watch",
    "dev:packages": "pnpm --filter './packages/*' dev",
    "prepare": "pnpm run build:all",
    "typecheck": "tsc --noEmit",
    "typecheck:packages": "pnpm --filter './packages/*' run typecheck",
    "format": "prettier --write .",
    "check": "prettier --check .",
    "test": "vitest"
  },
  "keywords": [
    "hono",
    "discord",
    "cloudflare-workers",
    "honocord",
    "interactions"
  ],
  "author": "The-LukeZ",
  "license": "MIT",
  "packageManager": "pnpm@10.27.0",
  "type": "module",
  "dependencies": {
    "@cloudflare/workers-types": "^4.20260403.1",
    "@discordjs/builders": "^1.14.1",
    "@discordjs/collection": "^2.1.1",
    "@discordjs/core": "^2.4.0",
    "@discordjs/rest": "^2.6.1",
    "@honocord/cache-base": "workspace:*",
    "discord-api-types": "0.38.39",
    "hono": "^4.12.10"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "prettier": "^3.8.1",
    "tsdown": "0.19.0-beta.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  },
  "repository": {
    "url": "git+https://github.com/The-LukeZ/honocord.git"
  },
  "homepage": "https://honocord.thelukez.com",
  "engines": {
    "node": ">=22.9.0"
  }
}
