---
// Three ways into the docs, one per kind of visitor.
const entries = [
  {
    title: "New to Honocord?",
    text: "Build and deploy your first command.",
    href: "/guides/getting-started/",
  },
  {
    title: "Coming from discord.js?",
    text: "What changes, and what stays the same.",
    href: "/guides/discord-js-differences/",
  },
  {
    title: "Looking something up?",
    text: "Every class, function and type.",
    href: "/reference/",
  },
];
---

<nav class="entry-points not-content" aria-label="Where to start">
  {
    entries.map((entry) => (
      <a href={entry.href}>
        <strong>{entry.title}</strong>
        <span>{entry.text}</span>
      </a>
    ))
  }
</nav>

<style>
  .entry-points {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    margin-block: 2.5rem 1rem;
  }

  a {
    background-color: var(--hc-embed);
    border: 1px solid var(--hc-hairline);
    border-radius: var(--hc-radius-code);
    color: var(--hc-text);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 1rem 1.1rem;
    text-decoration: none;
  }

  a:hover {
    border-color: var(--hc-muted);
  }

  strong {
    font-weight: 700;
  }

  span {
    color: var(--hc-muted);
    font-size: var(--sl-text-sm);
  }
</style>
