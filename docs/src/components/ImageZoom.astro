---
// Click (or Enter/Space) on a content image to view it full size in a dialog.
// Replaces starlight-image-zoom. Opt out per image with `data-zoom-off`.
// Images inside links are left alone so the link still works.
---

<dialog class="hc-zoom" aria-label="Zoomed image">
  <button class="hc-zoom-close" type="button" aria-label="Close zoomed image">
    <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
      <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" />
    </svg>
  </button>
  <img alt="" />
</dialog>

<style is:global>
  @layer honocord {
    .sl-markdown-content img[data-hc-zoomable] {
      cursor: zoom-in;
    }

    .hc-zoom {
      background: transparent;
      border: 0;
      max-height: none;
      max-width: none;
      padding: 0;
      width: 100%;
      height: 100%;
    }

    .hc-zoom[open] {
      display: grid;
      place-items: center;
    }

    /* Keep the page still behind the open dialog. */
    html:has(.hc-zoom[open]) {
      overflow: hidden;
    }

    .hc-zoom-close {
      align-items: center;
      background: var(--hc-button-secondary);
      border: 0;
      border-radius: var(--hc-radius-control);
      color: var(--hc-button-secondary-text);
      cursor: pointer;
      display: inline-flex;
      height: 2.5rem;
      inset-block-start: 1rem;
      inset-inline-end: 1rem;
      justify-content: center;
      position: fixed;
      width: 2.5rem;
    }

    .hc-zoom-close:hover {
      filter: brightness(1.1);
    }

    .hc-zoom::backdrop {
      background: color-mix(in oklab, var(--hc-bg) 92%, transparent);
    }

    .hc-zoom img {
      background: var(--hc-surface);
      border-radius: var(--hc-radius-code);
      cursor: zoom-out;
      max-height: 92vh;
      max-width: 94vw;
      object-fit: contain;
    }

    @media (prefers-reduced-motion: no-preference) {
      .hc-zoom[open] img {
        animation: hc-zoom-in 160ms ease-out;
      }

      @keyframes hc-zoom-in {
        from {
          opacity: 0;
          transform: scale(0.96);
        }
      }
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("dialog.hc-zoom");
  const zoomed = dialog?.querySelector("img");

  if (dialog && zoomed) {
    const open = (img: HTMLImageElement) => {
      zoomed.src = img.currentSrc || img.src;
      zoomed.alt = img.alt;
      dialog.showModal();
      // Focus the close button so keyboard users see how to get out.
      dialog.querySelector<HTMLButtonElement>(".hc-zoom-close")?.focus();
    };

    for (const img of document.querySelectorAll<HTMLImageElement>(".sl-markdown-content img")) {
      // Skip linked images, opt-outs, and custom components (.not-content, e.g. the hero avatar).
      if (img.closest("a, [data-zoom-off], .not-content") || img.hasAttribute("data-zoom-off")) continue;
      img.dataset["hcZoomable"] = "";
      img.tabIndex = 0;
      img.setAttribute("role", "button");
      img.setAttribute("aria-label", img.alt ? `Zoom image: ${img.alt}` : "Zoom image");
      img.addEventListener("click", () => open(img));
      img.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          open(img);
        }
      });
    }

    // Any click (the close button included) closes it; Esc is handled by the dialog itself.
    dialog.addEventListener("click", () => dialog.close());
  }
</script>
