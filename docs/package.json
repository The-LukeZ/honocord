{
  "name": "honocord-docs",
  "type": "module",
  "version": "3.0.0",
  "private": true,
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "docs:reference": "pnpm --filter honocord run docs:reference",
    "build": "pnpm run docs:reference && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold error",
    "deploy": "wrangler pages deploy"
  },
  "devDependencies": {
    "@fontsource/instrument-sans": "^5.3.0",
    "@resvg/resvg-js": "2.6.2",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.2.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "honocord": "workspace:*",
    "satori": "0.63.2",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "svelte-docsmith": "0.29.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "wrangler": "^4.160.1"
  }
}
